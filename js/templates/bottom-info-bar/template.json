{
  "format": "frame-maker-template",
  "formatVersion": 1,
  "template": {
    "id": "bottom-info-bar",
    "fields": [
      {
        "key": "colorScheme",
        "type": "select",
        "defaultValue": "white",
        "options": [
          {
            "value": "white"
          },
          {
            "value": "black"
          }
        ]
      },
      {
        "key": "frameAspectRatio",
        "type": "select",
        "defaultValue": "free",
        "normalizeValueKey": "frameAspectRatio",
        "parseValueKey": "frameAspectRatio",
        "options": [
          {
            "value": "free"
          },
          {
            "value": "original"
          },
          {
            "value": "1:1"
          },
          {
            "value": "5:4"
          },
          {
            "value": "4:3"
          },
          {
            "value": "3:2"
          },
          {
            "value": "16:9"
          },
          {
            "value": "4:5"
          },
          {
            "value": "3:4"
          },
          {
            "value": "2:3"
          },
          {
            "value": "9:16"
          }
        ]
      },
      {
        "key": "frameBorderWidth",
        "type": "number",
        "min": 0,
        "max": 100,
        "step": 0.1,
        "defaultValue": 10,
        "normalizeValueKey": "frameBorderWidth"
      },
      {
        "key": "frameTop",
        "type": "number",
        "min": 0,
        "max": 80,
        "step": 0.1,
        "defaultValue": 0
      },
      {
        "key": "frameRight",
        "type": "number",
        "min": 0,
        "max": 80,
        "step": 0.1,
        "defaultValue": 0
      },
      {
        "key": "frameBottom",
        "type": "number",
        "min": 0,
        "max": 80,
        "step": 0.1,
        "defaultValue": 9.5
      },
      {
        "key": "frameLeft",
        "type": "number",
        "min": 0,
        "max": 80,
        "step": 0.1,
        "defaultValue": 0
      }
    ],
    "defaultConfig": {
      "colorScheme": "white",
      "frameAspectRatio": "free",
      "frameBorderWidth": 10,
      "frameTop": 0,
      "frameRight": 0,
      "frameBottom": 9.5,
      "frameLeft": 0
    },
    "frame": {
      "sides": {
        "top": 0,
        "right": 0,
        "bottom": 9.5,
        "left": 0
      },
      "font": {
        "basis": "height",
        "size": 2.8,
        "min": 12
      }
    },
    "backgroundColor": "#121212",
    "textGroups": [
      {
        "id": "bottom-info-camera",
        "type": "group",
        "label": "相机信息",
        "region": "bottom",
        "anchor": "middle-left",
        "direction": "horizontal",
        "align": "center",
        "gapScale": 0.4,
        "offsetXScale": 0,
        "offsetYScale": 0,
        "visible": true,
        "style": {
          "fontId": "systemSans",
          "fontScale": 0.92,
          "fontWeight": 700,
          "fontStyle": "normal",
          "colorToken": "textPrimary",
          "color": "#000000EE",
          "letterSpacingScale": 0
        },
        "items": [
          {
            "id": "bottom-info-camera-text",
            "type": "text",
            "label": "相机",
            "content": "{{camera}}",
            "visible": true
          }
        ]
      },
      {
        "id": "bottom-info-meta",
        "type": "group",
        "label": "参数信息",
        "region": "bottom",
        "anchor": "middle-right",
        "direction": "horizontal",
        "align": "center",
        "gapScale": 0.58,
        "offsetXScale": 0,
        "offsetYScale": 0,
        "visible": true,
        "style": {
          "fontId": "systemSans",
          "fontScale": 0.8,
          "fontWeight": 600,
          "fontStyle": "normal",
          "colorToken": "textPrimary",
          "color": "#000000EE",
          "letterSpacingScale": 0
        },
        "items": [
          {
            "id": "bottom-info-focal-length",
            "type": "text",
            "label": "焦距",
            "content": "{{focalLength}}",
            "visible": true
          },
          {
            "id": "bottom-info-separator-1",
            "type": "separator",
            "label": "分隔线",
            "lengthScale": 1.1,
            "thicknessScale": 0.06,
            "colorToken": "separator",
            "color": "#0000005A",
            "visible": true
          },
          {
            "id": "bottom-info-aperture",
            "type": "text",
            "label": "光圈",
            "content": "{{aperture}}",
            "visible": true
          },
          {
            "id": "bottom-info-separator-2",
            "type": "separator",
            "label": "分隔线",
            "lengthScale": 1.1,
            "thicknessScale": 0.06,
            "colorToken": "separator",
            "color": "#0000005A",
            "visible": true
          },
          {
            "id": "bottom-info-shutter",
            "type": "text",
            "label": "快门",
            "content": "{{shutter}}",
            "visible": true
          },
          {
            "id": "bottom-info-separator-3",
            "type": "separator",
            "label": "分隔线",
            "lengthScale": 1.1,
            "thicknessScale": 0.06,
            "colorToken": "separator",
            "color": "#0000005A",
            "visible": true
          },
          {
            "id": "bottom-info-iso",
            "type": "text",
            "label": "ISO",
            "content": "ISO {{iso}}",
            "visible": true
          }
        ]
      }
    ],
    "appearanceFieldKey": "colorScheme",
    "appearanceDefaultKey": "white",
    "appearanceThemes": {
      "white": {
        "label": "白色",
        "canvasBackground": {
          "type": "solid",
          "color": "#FFFFFF"
        },
        "colors": {
          "frame": {
            "photoBorder": "#000000"
          },
          "surface": {
            "barBackground": "#FFFFFF"
          },
          "text": {
            "textPrimary": "#000000EE",
            "separator": "#0000005A"
          }
        }
      },
      "black": {
        "label": "黑色",
        "canvasBackground": {
          "type": "solid",
          "color": "#111111"
        },
        "colors": {
          "frame": {
            "photoBorder": "#FFFFFF"
          },
          "surface": {
            "barBackground": "#111111"
          },
          "text": {
            "textPrimary": "#F8FAFC",
            "separator": "#475569"
          }
        }
      }
    },
    "assets": {
      "thumbnail": "assets/thumbnail.jpg"
    },
    "overlays": [],
    "handlers": {}
  }
}
